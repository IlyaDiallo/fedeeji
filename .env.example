SUPERADMIN_PASSWORD=change_me_to_a_secure_password
SUPERADMIN_EMAIL=admin@exemple.com
JWT_SECRET=change_me_to_a_secure_random_string
PORT=3000

# Production : définir NODE_ENV=production (SMTP complet et HTTPS obligatoires).
# Node >= 20. Un seul processus Node, derrière un proxy HTTPS.
PUBLIC_APP_URL=https://feddeeji.example.org
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Feddeeji <noreply@example.org>
# 587 : STARTTLS obligatoire ; 465 : SMTP_SECURE=true. Certificats vérifiés.
# Laisser SMTP_HOST vide en développement sans email. Jamais de liens dans les logs.
# Proxies explicitement autorisés (adresses/sous-réseaux séparés par virgule).
# TRUST_PROXY=loopback
# Voir docs/authentication.md avant le premier démarrage/migration.

# HA : paramètres par collectif dans Membres, pas de JWT utilisateur dans les automations.
# Voir docs/home-assistant.md pour le retour HTTPS et les exemples Companion.
# Le stockage JSON et le scheduler nécessitent une seule instance/processus Node.
